{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Battle-Creek-LLC/secunit/schemas/capture-deps-sbom.schema.json",
  "title": "CaptureDepsSbom",
  "description": "Sidecar envelope for a CycloneDX SBOM. The BOM itself is written beside this file as a bare, schema-valid CycloneDX document so an assessor's tooling can read it unchanged; this envelope records what produced it and pins its hash.",
  "type": "object",
  "required": ["capturer", "version", "captured_at", "args", "result"],
  "additionalProperties": false,
  "properties": {
    "capturer": { "const": "deps.sbom" },
    "version": { "type": "string" },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "args": {
      "type": "object",
      "required": ["path", "ecosystem", "requested_spec_version"],
      "properties": {
        "path": { "type": "string" },
        "ecosystem": { "enum": ["rust", "python", "node"] },
        "requested_spec_version": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "bom_file",
        "bom_format",
        "bom_sha256",
        "component_count",
        "ecosystem",
        "generators",
        "spec_version"
      ],
      "additionalProperties": false,
      "properties": {
        "bom_file": {
          "type": "string",
          "description": "Filename of the bare BOM this envelope describes."
        },
        "bom_format": { "const": "CycloneDX" },
        "bom_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the BOM file's bytes as written, including its trailing newline."
        },
        "component_count": { "type": "integer", "minimum": 0 },
        "ecosystem": { "enum": ["rust", "python", "node"] },
        "generators": {
          "type": "array",
          "description": "Tools named in the BOM's metadata.tools, so the SBOM's provenance is auditable.",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "spec_version": {
          "enum": ["1.5", "1.6"],
          "description": "CycloneDX version the BOM declares. Rust caps at 1.5 because cargo-cyclonedx emits no higher."
        }
      }
    }
  }
}
